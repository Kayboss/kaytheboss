# Keys for the enquiry assistant (/api/commission).
# Copy to .env at the project root for local testing:
#   node --env-file=.env preview.mjs
# On Vercel, set these as Project > Settings > Environment Variables instead.

# --- Required to generate the AI draft reply (use EITHER one) ---
ANTHROPIC_API_KEY=sk-ant-...            # https://console.anthropic.com
# OPENAI_API_KEY=sk-...                 # ...or https://platform.openai.com
# Optional override (defaults are fine for a studio volume):
# ENQUIRY_MODEL=claude-3-5-sonnet-20241022

# --- Required to email you the enquiry + draft ---
RESEND_API_KEY=re_...                   # https://resend.com
ENQUIRY_TO_EMAIL=commissions@kaytheboss.studio
ENQUIRY_FROM_EMAIL=KAYTHEBOSS <onboarding@resend.dev>   # update once your domain is verified in Resend