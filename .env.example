# Local dev: build the site from the self-hosted admin/API (server/).
CONTENT_API_URL=http://127.0.0.1:8787

# Replies and new-enquiry notifications go out through Resend.
# 1. Create a key at https://resend.com/api-keys
# 2. Verify your sending domain at https://resend.com/domains
# 3. Put the domain address in ENQUIRY_FROM_EMAIL (onboarding@resend.dev
#    only delivers to the Resend account owner).
# Set all three on Vercel too — that is what delivers live enquiries when the
# admin is not hosted (leave CONTENT_API_URL unset there).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# ENQUIRY_FROM_EMAIL=KAYTHEBOSS <hello@kaytheboss.studio>
# ENQUIRY_TO_EMAIL=commissions@kaytheboss.studio
