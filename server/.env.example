# Copy to server/.env, then run with:
#   node --env-file=.env src/start.js
# (the `dev`/`start` scripts load this via Node --env-file in your shell, or export manually)

# --- Server ---
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info
NODE_ENV=development

# --- Database ---
# SQLite file path. Relative paths resolve from the repo root.
DATABASE_URL=./data/kaytheboss.db

# Where admin uploads are stored (served from /media/<file>).
# Defaults to <repo>/public/media. On Render this points at the disk.
# MEDIA_DIR=./public/media

# --- Admin ---
# Seed / create the first admin login:
ADMIN_EMAIL=you@kaytheboss.studio
ADMIN_PASSWORD=change-me-now

# --- Email (in-admin replies) ---
# Unset = send button disabled, mailto fallback. See README "Emails".
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# ENQUIRY_FROM_EMAIL=KAYTHEBOSS <hello@kaytheboss.studio>
# ENQUIRY_TO_EMAIL=commissions@kaytheboss.studio

# --- Mailbox sync (IMAP) ---
# Pulls INBOX + Sent into /admin/mail and files messages under enquiries.
# Gmail needs 2FA on and an App Password (not your normal password):
#   Google Account > Security > 2-Step Verification > App passwords
# Unset = sync is off; everything else keeps working. See README "Mailbox".
# IMAP_USER=commissions@kaytheboss.studio
# IMAP_PASSWORD=abcdefghijklmnop
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_FOLDERS=INBOX,[Gmail]/Sent Mail
# IMAP_SYNC_MINUTES=2
# IMAP_FETCH_LIMIT=40
# IMAP_SINCE_DAYS=30
